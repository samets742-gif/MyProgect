<Window x:Class="DSS_Situational.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DSS_Situational.ViewModels"
        Title="СППР — Ситуационный подход к принятию решений"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#F0F4F8">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Цветовая палитра -->
        <SolidColorBrush x:Key="PrimaryBrush"      Color="#2E5FA3"/>
        <SolidColorBrush x:Key="AccentBrush"       Color="#27AE60"/>
        <SolidColorBrush x:Key="DangerBrush"       Color="#E74C3C"/>
        <SolidColorBrush x:Key="HeaderBgBrush"     Color="#2E5FA3"/>
        <SolidColorBrush x:Key="PanelBgBrush"      Color="#FFFFFF"/>

        <!-- Стиль кнопки -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2E5FA3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3F7A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#B0BEC5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#27AE60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E8449"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#E74C3C"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C0392B"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Заголовок секции -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2E5FA3"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Карточка-панель -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2"
                                      Color="#AAAAAA" Opacity="0.18"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Шапка -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBgBrush}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="СППР на основе ситуационного подхода"
                               FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Система поддержки принятия решений · Анализ и распознавание ситуаций"
                               FontSize="11" Foreground="#BBDEFB" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="База знаний"
                        Style="{StaticResource GreenBtn}"
                        Command="{Binding OpenKnowledgeBaseCommand}"
                        FontSize="13"/>
            </Grid>
        </Border>

        <!-- Строка статуса -->
        <Border DockPanel.Dock="Bottom" Background="#E3F2FD" Padding="12,6">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#1A237E"/>
        </Border>

        <!-- Основное содержимое -->
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======= Левая панель: ввод ситуации ======= -->
            <StackPanel Grid.Column="0" Margin="0,0,4,0">

                <!-- Описание ситуации -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Описание текущей ситуации"
                                   Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Название:" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SituationName, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" Margin="0,0,0,6"
                                 BorderBrush="#B0BEC5" BorderThickness="1"/>
                        <TextBlock Text="Описание (необязательно):" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding SituationDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="6,4" Height="52" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 BorderBrush="#B0BEC5" BorderThickness="1"
                                 VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- Параметры ситуации -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Параметры ситуации"
                                       Style="{StaticResource SectionHeader}"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="+ Добавить"
                                    Style="{StaticResource GreenBtn}"
                                    FontSize="11" Padding="8,3"
                                    Command="{Binding AddParameterCommand}"/>
                            <Button Grid.Column="2" Content="− Удалить"
                                    Style="{StaticResource RedBtn}"
                                    FontSize="11" Padding="8,3"
                                    Command="{Binding RemoveParameterCommand}"
                                    CommandParameter="{Binding SelectedItem,
                                        ElementName=ParametersGrid}"/>
                        </Grid>
                        <DataGrid x:Name="ParametersGrid"
                                  ItemsSource="{Binding CurrentParameters}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  Height="200"
                                  BorderThickness="1" BorderBrush="#E0E0E0"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Параметр" Binding="{Binding Name}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Ед.изм." Binding="{Binding Unit}"
                                                    Width="55"/>
                                <DataGridTextColumn Header="Вес" Binding="{Binding Weight,
                                                    StringFormat=F2}" Width="45"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Вес [0..1] — важность параметра при сравнении"
                                   FontSize="10" Foreground="#78909C" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Настройки анализа -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,4">
                    <StackPanel>
                        <TextBlock Text="Настройки анализа" Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="Порог сходства:" FontSize="11"/>
                                <Slider Minimum="0.1" Maximum="0.99" TickFrequency="0.05"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding SimilarityThreshold}"
                                        Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding SimilarityThreshold, StringFormat=P0}"
                                           FontSize="11" HorizontalAlignment="Center"
                                           Foreground="#2E5FA3"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="Макс. результатов:" FontSize="11"/>
                                <Slider Minimum="1" Maximum="10" TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        Value="{Binding MaxResults}"
                                        Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding MaxResults}" FontSize="11"
                                           HorizontalAlignment="Center" Foreground="#2E5FA3"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Фильтр по категории:" FontSize="11" Margin="0,8,0,2"/>
                        <ComboBox ItemsSource="{Binding Categories}"
                                  SelectedItem="{Binding SelectedCategory}"
                                  Padding="6,3" FontSize="12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Кнопки действий -->
                <Border Style="{StaticResource Card}" Margin="4,0,4,4">
                    <StackPanel>
                        <Button Content="▶  Анализ ситуации"
                                Style="{StaticResource PrimaryBtn}"
                                Command="{Binding AnalyzeCommand}"
                                FontSize="14" FontWeight="SemiBold"
                                Height="40"/>
                        <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                            <Button Content="Сохранить как прецедент"
                                    Style="{StaticResource GreenBtn}"
                                    Command="{Binding LearnCommand}"
                                    FontSize="11"/>
                            <Button Content="Очистить"
                                    Style="{StaticResource RedBtn}"
                                    Command="{Binding ClearCommand}"
                                    FontSize="11"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ======= Правая панель: результаты ======= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="220"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Результаты распознавания"
                           Style="{StaticResource SectionHeader}"
                           Margin="8,8,0,4"/>

                <!-- Список результатов -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="4,0,4,4">
                    <ListBox ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,6" CornerRadius="4"
                                        BorderBrush="#E0E0E0" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SituationName}"
                                                       FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding RecommendedDecision.Title}"
                                                       Foreground="#546E7A" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock FontSize="10" Foreground="#78909C">
                                                <Run Text="Категория: "/>
                                                <Run Text="{Binding Category}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Индикатор сходства -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding SimilarityPercent}"
                                                       FontSize="16" FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#2E5FA3"/>
                                            <TextBlock Text="сходство" FontSize="9"
                                                       HorizontalAlignment="Center"
                                                       Foreground="#78909C"/>
                                        </StackPanel>

                                        <!-- Уровень уверенности -->
                                        <Border Grid.Column="2" CornerRadius="3" Padding="6,3"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ConfidenceLevel}"
                                                                     Value="Высокий">
                                                            <Setter Property="Background" Value="#C8E6C9"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConfidenceLevel}"
                                                                     Value="Средний">
                                                            <Setter Property="Background" Value="#FFF9C4"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConfidenceLevel}"
                                                                     Value="Низкий">
                                                            <Setter Property="Background" Value="#FFE0B2"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ConfidenceLevel}"
                                                                     Value="Очень низкий">
                                                            <Setter Property="Background" Value="#FFCDD2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding ConfidenceLevel}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Детали выбранного решения -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="4,0,4,4">
                    <StackPanel>
                        <TextBlock Text="Рекомендуемое решение"
                                   Style="{StaticResource SectionHeader}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SelectedResult.RecommendedDecision.Title,
                                           FallbackValue='—'}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="#2E5FA3" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedResult.RecommendedDecision.Description,
                                           FallbackValue=''}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Margin="0,4,0,0" Foreground="#37474F"/>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#78909C">
                                    <Run Text="Приоритет: "/>
                                    <Run Text="{Binding SelectedResult.RecommendedDecision.Priority,
                                         FallbackValue='—'}"/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Действия:" FontSize="12"
                                           FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding SelectedResult.RecommendedDecision.Actions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                                       Margin="0,1">
                                                <Run Text="• "/>
                                                <Run Text="{Binding}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
